{
  "expo": {
    "name": "FortalRunners",
    "slug": "fortalrunners",
    "scheme": "fortalrunners",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "imageWidth": 160,
      "backgroundColor": "#06181A"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Para gravar sua corrida mesmo com a tela apagada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Para a foto do check-in de marco histórico, tirada só pela câmera do app.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.allvasc.fortalrunners",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Para gravar sua corrida e conquistar território.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Para gravar sua corrida mesmo com a tela apagada.",
        "NSMotionUsageDescription": "Para medir cadência e passos com precisão.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.allvasc.fortalrunners",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06181A"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "http://localhost:8090",
      "eas": {
        "projectId": "452a88ac-6c8a-4201-a07f-2fc4d2bb2e58"
      }
    },
    "owner": "allvasc"
  }
}
