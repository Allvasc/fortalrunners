# Copie para .env e ajuste. Nunca commite o .env.
APP_ENV=dev
# 8080 costuma estar numa faixa reservada pelo Windows (Hyper-V/Docker).
# Use 8090 em dev; produção pode voltar a 8080.
HTTP_ADDR=:8090
LOG_LEVEL=debug

DATABASE_URL=postgres://fortalrunners:dev@localhost:5432/fortalrunners?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# JWT — gere uma chave forte para produção (openssl rand -base64 48)
JWT_SECRET=dev-only-change-me-please-32bytes-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# 2FA (TOTP) — cifra o segredo em repouso (AES-256-GCM). base64 de EXATAMENTE 32 bytes.
# Gere: openssl rand -base64 32   (obrigatório em produção; dev usa um default fixo)
MFA_ENC_KEY=

# OAuth (Fase 0: Google). Preencha ao configurar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/v1/auth/oauth/google/callback

CORS_ORIGINS=http://localhost:5173
