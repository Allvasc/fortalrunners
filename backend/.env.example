# Copie para .env e ajuste. Nunca commite o .env.
# Documento de referência completo: docs/variaveis-de-ambiente.html

# ─────────────────────────────────────────────────────────────
# Núcleo (obrigatório)
# ─────────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | staging | prod
# 8080 costuma estar numa faixa reservada pelo Windows (Hyper-V/Docker).
# Use 8090 em dev; em produção o Render injeta PORT automaticamente.
HTTP_ADDR=:8090
LOG_LEVEL=debug                   # debug | info | warn | error

DATABASE_URL=postgres://fortalrunners:dev@localhost:5432/fortalrunners?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222    # sem NATS a API processa território/rollup no próprio processo

# JWT — gere uma chave forte para produção: openssl rand -base64 48
# Em prod precisa de >= 32 bytes; assina os tokens de acesso e o QR do atleta.
JWT_SECRET=dev-only-change-me-please-32bytes-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# 2FA (TOTP) — cifra o segredo TOTP, os tokens de integração e os telefones de
# contato de emergência em repouso (AES-256-GCM). base64 de EXATAMENTE 32 bytes.
# Gere: openssl rand -base64 32   (obrigatório em produção; dev usa um default fixo)
MFA_ENC_KEY=

# Origens permitidas no CORS (o front roda noutro domínio). Também define para
# onde o callback OAuth redireciona e a base do link público de beacon.
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Login social (opcional — vazio = rota responde 501)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/v1/auth/oauth/google/callback

# Apple Sign In: Services ID + chave .p8 (PKCS8 EC) do Apple Developer.
# APPLE_P8_KEY = conteúdo do arquivo .p8 inteiro (com as linhas BEGIN/END).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_P8_KEY=
APPLE_REDIRECT_URL=http://localhost:8090/v1/auth/oauth/apple/callback

# ─────────────────────────────────────────────────────────────
# Strava — import de atividades (opcional — vazio = desativado)
# ─────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URL=http://localhost:8090/v1/integrations/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=      # string que você escolhe; deve bater no cadastro do webhook no Strava

# ─────────────────────────────────────────────────────────────
# Pagamentos — Asaas (opcional — vazio = modo sandbox, PIX marcado como demo)
# ─────────────────────────────────────────────────────────────
ASAAS_API_KEY=                    # chave da API do Asaas (cofre)
ASAAS_WEBHOOK_SECRET=             # segredo HMAC do webhook; se vazio, a assinatura não é verificada (só dev)

# ─────────────────────────────────────────────────────────────
# Coach IA (opcional — vazio = fallback determinístico, sem LLM)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Clima (opcional — vazio = leitura estática de Fortaleza)
# ─────────────────────────────────────────────────────────────
WEATHER_API_KEY=

# ─────────────────────────────────────────────────────────────
# Operação
# ─────────────────────────────────────────────────────────────
AUTO_MIGRATE=true                 # "false" desliga a migração automática no boot da API
# PORT — injetado pelo Render; sobrepõe HTTP_ADDR. Não setar em dev.
# TARGET — build arg do Docker (api|worker|scheduler|migrate), não é env de runtime.
